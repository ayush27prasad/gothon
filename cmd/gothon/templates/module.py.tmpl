"""Tasks in this module are called from Go through the generated client.

Conventions:
- Mark each function Go calls with @gothon.task.
- A task takes at most one argument. Annotate it and the return type, ideally
  with pydantic models: they validate the data and become the Go types.
- Tasks may be `async def`; they run on one event loop per worker.
- Load expensive things (models, clients) at module level. That runs once per
  worker process, not once per call. `gothon gen` also imports this module and
  sets GOTHON_GEN=1 while it does; check it to skip heavy work there.
{{- if .Settings}}
- Configuration (API keys, URLs) goes on the Settings class below, never through
  os.getenv: Go fills it in through the generated Settings type.
{{- else}}
- Need configuration such as API keys? Add a pydantic-settings class (run
  `uv add --project <python dir> pydantic-settings`) and run `gothon gen`: Go
  gets a typed Settings struct, and Start asks for it.
{{- end}}
- Add Python dependencies with `uv add --project <python dir> <package>`.
- After changing a task or model, run `gothon gen` to update the Go client.
"""

from pydantic import BaseModel, Field
{{- if .Settings}}
from pydantic_settings import BaseSettings, SettingsConfigDict
{{- end}}

import gothon
{{if .Settings}}

class Settings(BaseSettings):
    """Read from environment variables prefixed {{.EnvPrefix}}."""

    model_config = SettingsConfigDict(env_prefix="{{.EnvPrefix}}")

    greeting: str = Field("Hello", description="Word used to greet.")
    # api_key: SecretStr = Field(description="Credential for an external service.")


settings = Settings()
{{end}}

class GreetIn(BaseModel):
    name: str = Field(description="Who to greet.")


class GreetOut(BaseModel):
    message: str


@gothon.task
def greet(inp: GreetIn) -> GreetOut:
    """Return a greeting for the given name."""
{{- if .Settings}}
    return GreetOut(message=f"{settings.greeting}, {inp.name}!")
{{- else}}
    return GreetOut(message=f"Hello, {inp.name}!")
{{- end}}
